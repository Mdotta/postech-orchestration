#!/bin/bash
set -euo pipefail

yum update -y
yum install -y docker

systemctl start docker
systemctl enable docker

mkdir -p /opt/monitoring/prometheus
mkdir -p /opt/monitoring/grafana/provisioning/datasources
mkdir -p /opt/monitoring/grafana/provisioning/dashboards

# ── Prometheus configuration ──────────────────────────────────────────
cat > /opt/monitoring/prometheus/prometheus.yml <<'PROMEOF'
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
%{ for name, target in scrape_targets ~}
  - job_name: '${name}'
    metrics_path: /metrics
    static_configs:
      - targets: ['${target.host}:${target.port}']
%{ endfor ~}
PROMEOF

# ── Grafana datasource ────────────────────────────────────────────────
cat > /opt/monitoring/grafana/provisioning/datasources/prometheus.yml <<'DSYML'
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
DSYML

# ── Grafana dashboard provider config ─────────────────────────────────
cat > /opt/monitoring/grafana/provisioning/dashboards/default.yml <<'DASHYML'
apiVersion: 1
providers:
  - name: default
    folder: ''
    type: file
    options:
      path: /etc/grafana/provisioning/dashboards
DASHYML

# ── docker-compose ────────────────────────────────────────────────────
cat > /opt/monitoring/docker-compose.yml <<'DCOMP'
services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=15d'
    restart: unless-stopped
    ports:
      - "9090:9090"

  grafana:
    image: grafana/grafana-oss:latest
    container_name: grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${grafana_admin_password}
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana_data:/var/lib/grafana
    restart: unless-stopped
    ports:
      - "3000:3000"
    depends_on:
      - prometheus

volumes:
  prometheus_data:
  grafana_data:
DCOMP

chmod 600 /opt/monitoring/docker-compose.yml

curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose

cd /opt/monitoring && docker-compose up -d
