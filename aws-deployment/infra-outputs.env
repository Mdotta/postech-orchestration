# infra-outputs.env
# Purpose: Stores the AWS resource IDs and endpoints produced by each deployment
# script.  This file is GENERATED automatically by the scripts — do not edit by
# hand during a deployment run.
#
# Template below shows every variable written by the scripts, with example
# placeholder values.  Keep a copy of the real file after each successful deploy
# so you can inspect resource IDs or re-run individual scripts without running
# the full pipeline.
#
# WARNING: This file may contain the DB_PASSWORD value.  Do NOT commit a copy
# that contains real credentials to version control.

# --- 01-networking.sh outputs ---
VPC_ID=vpc-0123456789abcdef0
PUB_SUBNET_1=subnet-0aaaaaaaaaaaaaaaa
PUB_SUBNET_2=subnet-0bbbbbbbbbbbbbbb
PRIV_SUBNET_1=subnet-0ccccccccccccccc
PRIV_SUBNET_2=subnet-0ddddddddddddddd
ECS_SG=sg-0eeeeeeeeeeeeeeee
RDS_SG=sg-0ffffffffffffffff

# --- 02-ecr-push.sh outputs ---
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# --- 03-sqs.sh outputs ---
USERS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/users-events
CATALOG_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/catalog-events

# --- 04-rds.sh outputs ---
USERS_DB_HOST=users-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
CATALOG_DB_HOST=catalog-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PASSWORD is written here at runtime — never commit the real value
DB_PASSWORD=ChangeMe_CoursePassword123!

# --- 05-iam.sh outputs (AWS Academy LabRole) ---
TASK_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole
EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole

# --- 06-ecs.sh outputs ---
USERS_IP=54.123.45.67
CATALOG_IP=18.234.56.78

# --- 07-apigateway.sh outputs ---
API_ID=abcdef1234
AUTHORIZER_ID=zyxwvu9876
USERS_INTEGRATION_ID=integ-111111
CATALOG_INTEGRATION_ID=integ-222222
GATEWAY_URL=https://abcdef1234.execute-api.us-east-1.amazonaws.com
