# =============================================================================
# Environment Variables — Postech Orchestration
#
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# =============================================================================

# --- Required: RDS Database Password ---
# Your PostgreSQL master password (any string, 8+ chars)
TF_VAR_db_password=

# --- Required: AWS Credentials (for K8s pods to use SNS/SQS/DynamoDB/Cognito) ---
# Get these from the AWS Academy lab page (AWS Details)
# They expire every 4-8 hours — re-run setup.sh to refresh
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Optional ---
# AWS_REGION=us-east-1
